---
import BaseLayout from '../layouts/BaseLayout.astro';
import Countdown from '../components/Countdown.astro';
import DressCode from '../components/DressCode.astro';
import EventDetails from '../components/EventDetails.astro';
import Gallery from '../components/Gallery.astro';
import Gifts from '../components/Gifts.astro';
import Hero from '../components/Hero.astro';
import Rsvp from '../components/Rsvp.astro';
import { countdown, galleryItems, invitation } from '../data/invitation';
---

<BaseLayout
  title={`Mis XV años | ${invitation.celebrant}`}
  description={`Invitación a los XV años de ${invitation.celebrant}. ${invitation.date}.`}
>
  <main>
    <Hero name={invitation.celebrant} date={invitation.date} />
    <div id="invitacion">
      <Countdown items={countdown} />
      <EventDetails
        date={invitation.date}
        time={invitation.time}
        venue={invitation.venue}
        address={invitation.address}
        mapsUrl={invitation.mapsUrl}
      />
      <DressCode dressCode={invitation.dressCode} note={invitation.dressCodeNote} />
      <Gallery items={galleryItems} />
      <Gifts
        note={invitation.giftNote}
        bankDetails={invitation.bankDetails}
        qrImage={invitation.qrImage}
      />
      <Rsvp name={invitation.shortName} rsvpUrl={invitation.rsvpUrl} />
    </div>
  </main>
</BaseLayout>
