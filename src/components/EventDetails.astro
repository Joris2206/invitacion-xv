---
import SectionHeading from './SectionHeading.astro';

interface Props {
  date: string;
  time: string;
  venue: string;
  address: string;
  mapsUrl: string;
}

const { date, time, venue, address, mapsUrl } = Astro.props;
---

<section class="section details-section" aria-labelledby="details-title">
  <div class="container">
    <SectionHeading
      id="details-title"
      eyebrow="Acompáñame"
      title="Detalles del gran día"
      description="Será una alegría contar con tu presencia y celebrar juntos esta nueva etapa."
    />

    <div class="details-grid">
      <article class="detail-card">
        <div class="icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
        </div>
        <p class="detail-label">Fecha</p>
        <h3>{date}</h3>
      </article>

      <article class="detail-card">
        <div class="icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </div>
        <p class="detail-label">Hora</p>
        <h3>{time}</h3>
        <p>Recepción y celebración</p>
      </article>

      <article class="detail-card detail-card--location">
        <div class="icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        </div>
        <p class="detail-label">Lugar</p>
        <h3>{venue}</h3>
        <p>{address}</p>
        <a class="text-link" href={mapsUrl} aria-label={`Ver ubicación de ${venue} en Google Maps`}>
          Ver ubicación
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </article>
    </div>
  </div>
</section>
