---
import SectionHeading from './SectionHeading.astro';
---

<section class="section gifts-section" aria-labelledby="gifts-title">
  <div class="container container--narrow gifts-content">
    <div class="gift-card">
      <span class="gift-spark gift-spark--one" aria-hidden="true">✦</span>
      <span class="gift-spark gift-spark--two" aria-hidden="true">✦</span>

      <div class="gift-icon" aria-hidden="true">
        <svg viewBox="0 0 64 64">
          <rect x="8" y="16" width="48" height="34" rx="3" />
          <path d="m10 19 22 18 22-18M10 47l16-15M54 47 38 32" />
        </svg>
      </div>

      <SectionHeading id="gifts-title" eyebrow="DETALLE DE REGALOS" title="Lluvia de sobres" />
      <p class="gift-message">Tu presencia es el regalo más especial. Si deseas obsequiarme algo adicional, agradeceré una muestra de cariño en sobre.</p>
    </div>
  </div>
</section>
