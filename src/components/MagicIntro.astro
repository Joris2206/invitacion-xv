---
const particles = Array.from({ length: 26 }, (_, index) => ({
  id: index,
  x: 8 + ((index * 37) % 84),
  y: 24 + ((index * 19) % 62),
  size: 2 + (index % 4) * 1.2,
  delay: (index % 9) * 0.13,
  duration: 2.8 + (index % 5) * 0.38,
  drift: -18 + ((index * 13) % 37),
}));
---

<dialog
  class="magic-intro"
  aria-label="Introducción de bosque mágico"
  aria-modal="true"
>
  <div class="intro-scene" aria-hidden="true">
    <img
      class="intro-forest"
      src="/images/magic/forest-night.png"
      alt=""
      width="1672"
      height="940"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="intro-vignette"></div>
    <div class="intro-moon-glow"></div>
    <div class="intro-rays"></div>

    <div class="intro-mist intro-mist--back"></div>
    <div class="intro-mist intro-mist--middle"></div>
    <div class="intro-mist intro-mist--front"></div>

    <div class="intro-doe-light"></div>

    <div class="intro-doe">
      <img
        src="/images/magic/silver-doe.png"
        alt=""
        width="1152"
        height="1376"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="intro-particles">
      {
        particles.map((particle) => (
          <span
            class="intro-particle"
            style={`--x:${particle.x}%;--y:${particle.y}%;--size:${particle.size}px;--delay:${particle.delay}s;--duration:${particle.duration}s;--drift:${particle.drift}px;`}
          ></span>
        ))
      }
    </div>

    <div class="intro-reveal"></div>
  </div>

  <button class="intro-skip" type="button" autofocus>
    Saltar introducción
  </button>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.querySelector('.magic-intro');
    const skip = dialog?.querySelector('.intro-skip');
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    );
    const storageKey = 'invitacion-xv-magic-intro-seen';
    const assetPaths = [
      '/images/magic/forest-night.png',
      '/images/magic/silver-doe.png',
    ];

    let isRunning = false;
    let isPreparing = false;
    let finishTimer;
    let fadeTimer;
    let previousHtmlOverflow = '';
    let previousBodyOverflow = '';

    if (!dialog || !skip || !dialog.showModal) return;

    const isSlytherinActive = () =>
      document.documentElement.dataset.theme === 'slytherin-magico';

    const preloadAsset = (src) =>
      new Promise((resolve) => {
        const image = new Image();
        image.decoding = 'async';

        image.onload = async () => {
          try {
            await image.decode?.();
          } catch {
            // La descarga ya terminó; no bloqueamos por un decode no compatible.
          }

          resolve(true);
        };

        image.onerror = () => resolve(false);
        image.src = src;
      });

    // Comienza a descargar los recursos desde que carga la página.
    const assetsReady = Promise.all(assetPaths.map(preloadAsset)).then(
      (results) => results.every(Boolean),
    );

    const focusHero = () => {
      const hero = document.getElementById('hero-title');

      if (!hero) return;

      const previousTabIndex = hero.getAttribute('tabindex');
      hero.setAttribute('tabindex', '-1');
      hero.focus({ preventScroll: true });

      hero.addEventListener(
        'blur',
        () => {
          if (previousTabIndex === null) {
            hero.removeAttribute('tabindex');
          } else {
            hero.setAttribute('tabindex', previousTabIndex);
          }
        },
        { once: true },
      );
    };

    const preventScroll = (event) => event.preventDefault();

    const onCancel = (event) => {
      event.preventDefault();
      finish({ focus: true });
    };

    const onKeyDown = (event) => {
      if (event.key === 'Escape') finish({ focus: true });
    };

    const onMotionChange = (event) => {
      if (event.matches) finish();
    };

    const finish = ({ focus = false } = {}) => {
      if (!isRunning && !isPreparing) return;

      isRunning = false;
      isPreparing = false;
      window.clearTimeout(fadeTimer);
      window.clearTimeout(finishTimer);

      dialog.classList.remove('is-loading', 'is-playing', 'is-leaving');
      document.documentElement.style.overflow = previousHtmlOverflow;
      document.body.style.overflow = previousBodyOverflow;

      dialog.removeEventListener('cancel', onCancel);
      dialog.removeEventListener('wheel', preventScroll);
      dialog.removeEventListener('touchmove', preventScroll);
      window.removeEventListener('keydown', onKeyDown);
      reducedMotion.removeEventListener('change', onMotionChange);

      if (dialog.open) dialog.close();

      if (focus) focusHero();
    };

    const start = async ({ replay = false } = {}) => {
      if (
        isRunning ||
        isPreparing ||
        reducedMotion.matches ||
        !isSlytherinActive()
      ) {
        return;
      }

      if (!replay) {
        try {
          if (sessionStorage.getItem(storageKey)) return;
        } catch {
          return;
        }
      }

      isPreparing = true;
      previousHtmlOverflow = document.documentElement.style.overflow;
      previousBodyOverflow = document.body.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';

      try {
        // Se abre de inmediato: nunca se muestra primero la página normal.
        dialog.showModal();
        dialog.classList.add('is-loading');
      } catch {
        isPreparing = false;
        return;
      }

      dialog.addEventListener('cancel', onCancel);
      dialog.addEventListener('wheel', preventScroll, { passive: false });
      dialog.addEventListener('touchmove', preventScroll, { passive: false });
      window.addEventListener('keydown', onKeyDown);
      reducedMotion.addEventListener('change', onMotionChange);

      const loadedSuccessfully = await assetsReady;

      // El usuario pudo haber pulsado “Saltar introducción” mientras cargaba.
      if (!isPreparing || !dialog.open) return;

      if (
        !loadedSuccessfully ||
        reducedMotion.matches ||
        !isSlytherinActive()
      ) {
        finish();
        return;
      }

      if (!replay) {
        try {
          sessionStorage.setItem(storageKey, '1');
        } catch {
          // La intro puede continuar aunque sessionStorage falle.
        }
      }

      isPreparing = false;
      isRunning = true;

      dialog.classList.remove('is-loading');

      requestAnimationFrame(() => {
        dialog.classList.add('is-playing');
      });

      fadeTimer = window.setTimeout(() => {
        dialog.classList.add('is-leaving');
      }, 3650);

      finishTimer = window.setTimeout(() => {
        finish();
      }, 4300);
    };

    skip.addEventListener('click', () => finish({ focus: true }));

    document.addEventListener('magic-intro:replay', () => {
      start({ replay: true });
    });

    start();
  })();
</script>

<style>
  .magic-intro {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: #020907;
    color: #eef7f3;
    opacity: 1;
    transition: opacity 620ms cubic-bezier(.22, 1, .36, 1);
  }

  .magic-intro::backdrop {
    background: #020907;
  }

  .magic-intro:not([open]) {
    display: none;
  }

  .magic-intro.is-leaving {
    opacity: 0;
  }

  .intro-scene,
  .intro-forest,
  .intro-vignette,
  .intro-moon-glow,
  .intro-rays,
  .intro-mist,
  .intro-doe-light,
  .intro-doe,
  .intro-particles,
  .intro-reveal {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .intro-scene {
    overflow: hidden;
    background: #020907;
    transform: scale(1.03);
  }

  .intro-forest {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(.82) contrast(1.04) brightness(.76);
    transform: scale(1.09);
  }

  .intro-vignette {
    background:
      radial-gradient(
        ellipse at center,
        transparent 26%,
        rgba(0, 13, 9, .18) 58%,
        rgba(0, 6, 4, .92) 100%
      );
  }

  .intro-moon-glow {
    background:
      radial-gradient(
        circle at 68% 18%,
        rgba(222, 245, 240, .22),
        rgba(152, 216, 194, .08) 9%,
        transparent 26%
      );
    mix-blend-mode: screen;
    opacity: .65;
  }

  .intro-rays {
    opacity: 0;
    background:
      linear-gradient(
        112deg,
        transparent 33%,
        rgba(176, 244, 213, .1) 44%,
        transparent 57%
      ),
      linear-gradient(
        72deg,
        transparent 42%,
        rgba(191, 229, 222, .08) 53%,
        transparent 66%
      );
    mix-blend-mode: screen;
    transform: scale(1.2);
  }

  .intro-mist {
    opacity: 0;
    filter: blur(18px);
    mix-blend-mode: screen;
  }

  .intro-mist--back {
    background:
      radial-gradient(
        ellipse at 26% 57%,
        rgba(175, 211, 207, .22),
        transparent 44%
      ),
      radial-gradient(
        ellipse at 72% 61%,
        rgba(110, 188, 153, .18),
        transparent 46%
      );
  }

  .intro-mist--middle {
    background:
      radial-gradient(
        ellipse at 49% 70%,
        rgba(194, 227, 221, .26),
        transparent 51%
      );
    filter: blur(27px);
  }

  .intro-mist--front {
    inset: auto -16% -22%;
    height: 51%;
    background:
      radial-gradient(
        ellipse at center,
        rgba(205, 232, 227, .26),
        rgba(87, 165, 132, .1) 37%,
        transparent 70%
      );
    filter: blur(35px);
  }

  .intro-doe-light {
    inset: auto 50% 19%;
    width: min(34vw, 420px);
    height: min(17vw, 180px);
    transform: translateX(-50%) scale(.4);
    border-radius: 50%;
    opacity: 0;
    background:
      radial-gradient(
        ellipse,
        rgba(237, 250, 248, .42),
        rgba(102, 223, 171, .18) 36%,
        transparent 72%
      );
    filter: blur(18px);
    mix-blend-mode: screen;
  }

  .intro-doe {
    inset: auto 50% 16%;
    width: clamp(150px, 18vw, 290px);
    height: auto;
    opacity: 0;
    transform: translate(-50%, 8%) scale(.72);
    transform-origin: center bottom;
    filter: blur(13px) drop-shadow(0 0 0 rgba(0, 0, 0, 0));
  }

  .intro-doe img {
    display: block;
    width: 100%;
    height: auto;
    filter:
      brightness(1.08)
      contrast(1.02)
      drop-shadow(0 0 22px rgba(205, 248, 238, .38))
      drop-shadow(0 0 52px rgba(77, 213, 157, .22));
  }

  .intro-particles {
    overflow: hidden;
    mix-blend-mode: screen;
  }

  .intro-particle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    border-radius: 999px;
    opacity: 0;
    background: rgba(235, 255, 250, .95);
    box-shadow:
      0 0 7px rgba(238, 255, 251, .9),
      0 0 15px rgba(84, 230, 164, .66);
  }

  .intro-reveal {
    opacity: 0;
    background:
      radial-gradient(
        circle at 50% 60%,
        rgba(235, 255, 249, .96),
        rgba(150, 240, 194, .68) 16%,
        rgba(23, 111, 76, .4) 41%,
        transparent 70%
      );
    mix-blend-mode: screen;
    transform: scale(.2);
  }

  .intro-skip {
    position: absolute;
    z-index: 5;
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
    min-height: 44px;
    padding: .62rem 1rem;
    border: 1px solid rgba(213, 235, 228, .72);
    border-radius: 999px;
    background: rgba(3, 28, 20, .72);
    color: #eef7f3;
    box-shadow: 0 6px 24px rgba(0, 0, 0, .24);
    backdrop-filter: blur(8px);
    font: 600 .82rem var(--font-body);
    letter-spacing: .02em;
    cursor: pointer;
  }

  .intro-skip:hover {
    background: rgba(16, 87, 61, .88);
  }

  .intro-skip:focus-visible {
    outline: 3px solid #eef7f3;
    outline-offset: 4px;
  }

  .magic-intro.is-playing .intro-scene {
    animation: camera-move 4.3s cubic-bezier(.22, 1, .36, 1) forwards;
  }

  .magic-intro.is-playing .intro-forest {
    animation: forest-depth 4.3s cubic-bezier(.22, 1, .36, 1) forwards;
  }

  .magic-intro.is-playing .intro-rays {
    animation: rays-awaken 2.2s ease-out .55s both;
  }

  .magic-intro.is-playing .intro-mist--back {
    animation: mist-back 4.1s ease-in-out both;
  }

  .magic-intro.is-playing .intro-mist--middle {
    animation: mist-middle 3.6s ease-in-out .5s both;
  }

  .magic-intro.is-playing .intro-mist--front {
    animation: mist-front 4s ease-in-out .3s both;
  }

  .magic-intro.is-playing .intro-doe-light {
    animation: doe-light 3.65s cubic-bezier(.22, 1, .36, 1) .85s both;
  }

  .magic-intro.is-playing .intro-doe {
    animation:
      doe-appear 2.35s cubic-bezier(.22, 1, .36, 1) .95s both,
      doe-breathe 2.8s ease-in-out 2.35s both;
  }

  .magic-intro.is-playing .intro-particle {
    animation: particle-rise var(--duration) ease-in-out var(--delay) both;
  }

  .magic-intro.is-playing .intro-reveal {
    animation: magical-reveal 1s cubic-bezier(.22, 1, .36, 1) 3.3s both;
  }

  .intro-scene {
    opacity: 0;
    transition: opacity 360ms ease;
  }

  .magic-intro.is-playing .intro-scene {
    opacity: 1;
  }

  .magic-intro.is-loading::before {
    content: '';
    position: absolute;
    inset: -25%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 50% 56%,
        rgba(118, 230, 169, .22),
        rgba(37, 113, 78, .12) 22%,
        transparent 53%
      ),
      radial-gradient(
        circle at 65% 18%,
        rgba(215, 241, 235, .1),
        transparent 26%
      ),
      #020907;
    animation: magic-loading-glow 1.6s ease-in-out infinite alternate;
  }

  .magic-intro.is-loading .intro-skip {
    z-index: 5;
  }

  @keyframes magic-loading-glow {
    from {
      opacity: .55;
      transform: scale(.95);
    }

    to {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  @keyframes camera-move {
    0% { transform: scale(1.08) translate3d(0, 1.5%, 0); }
    52% { transform: scale(1.035) translate3d(-.6%, -.3%, 0); }
    100% { transform: scale(1.12) translate3d(0, -1.1%, 0); }
  }

  @keyframes forest-depth {
    0% { transform: scale(1.12) translate3d(0, 1%, 0); filter: saturate(.64) brightness(.57); }
    48% { transform: scale(1.075) translate3d(.35%, 0, 0); filter: saturate(.8) brightness(.74); }
    100% { transform: scale(1.16) translate3d(-.3%, -1.1%, 0); filter: saturate(.94) brightness(.86); }
  }

  @keyframes rays-awaken {
    0% { opacity: 0; transform: scale(1.2) rotate(-3deg); }
    45% { opacity: 1; }
    100% { opacity: .38; transform: scale(1.04) rotate(1deg); }
  }

  @keyframes mist-back {
    0% { opacity: 0; transform: translate3d(-7%, 4%, 0) scale(.86); }
    34% { opacity: .45; }
    100% { opacity: .3; transform: translate3d(8%, -2%, 0) scale(1.15); }
  }

  @keyframes mist-middle {
    0% { opacity: 0; transform: translate3d(12%, 8%, 0) scale(.76); }
    40% { opacity: .56; }
    100% { opacity: .29; transform: translate3d(-9%, -4%, 0) scale(1.2); }
  }

  @keyframes mist-front {
    0% { opacity: 0; transform: translate3d(-8%, 18%, 0) scale(.78); }
    42% { opacity: .5; }
    100% { opacity: .22; transform: translate3d(10%, -3%, 0) scale(1.18); }
  }

  @keyframes doe-light {
    0% { opacity: 0; transform: translateX(-50%) scale(.34); }
    38% { opacity: .92; transform: translateX(-50%) scale(1.08); }
    100% { opacity: .32; transform: translateX(-50%) scale(1.32); }
  }

  @keyframes doe-appear {
    0% {
      opacity: 0;
      transform: translate(-58%, 11%) scale(.62);
      filter: blur(16px);
    }
    52% {
      opacity: 1;
      transform: translate(-50%, 0) scale(.9);
      filter: blur(0);
    }
    100% {
      opacity: .96;
      transform: translate(-48%, -1.5%) scale(.95);
      filter: blur(0);
    }
  }

  @keyframes doe-breathe {
    0%, 100% { transform: translate(-48%, -1.5%) scale(.95); }
    50% { transform: translate(-47.4%, -2.3%) scale(.965); }
  }

  @keyframes particle-rise {
    0% {
      opacity: 0;
      transform: translate3d(0, 14px, 0) scale(.4);
    }
    24% { opacity: .86; }
    78% { opacity: .42; }
    100% {
      opacity: 0;
      transform: translate3d(var(--drift), -110px, 0) scale(1.3);
    }
  }

  @keyframes magical-reveal {
    0% { opacity: 0; transform: scale(.15); }
    58% { opacity: .95; transform: scale(1.18); }
    100% { opacity: 1; transform: scale(2.25); }
  }

  @media (max-width: 700px) {
    .intro-doe {
      width: min(48vw, 235px);
      bottom: 19%;
    }

    .intro-doe-light {
      bottom: 21%;
      width: min(66vw, 330px);
    }

    .intro-forest {
      object-position: 51% center;
    }

    .intro-particle:nth-child(n + 16) {
      display: none;
    }

    .intro-mist--front {
      opacity: .75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .magic-intro[open] {
      display: none;
    }
  }
</style>