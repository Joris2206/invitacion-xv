---
// Original vector scene. No remote assets or client framework required.
---
<dialog class="magic-intro" aria-label="Introducción de bosque mágico" aria-modal="true">
  <button class="intro-skip" type="button" autofocus>Saltar introducción</button>
  <svg class="intro-scene" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="intro-night" cx="55%" cy="38%" r="75%"><stop stop-color="#183b38"/><stop offset=".55" stop-color="#0a231e"/><stop offset="1" stop-color="#020b09"/></radialGradient>
      <radialGradient id="intro-aura"><stop stop-color="#dcefe8" stop-opacity=".35"/><stop offset=".35" stop-color="#49a078" stop-opacity=".18"/><stop offset="1" stop-color="#49a078" stop-opacity="0"/></radialGradient>
      <radialGradient id="intro-moon"><stop stop-color="#e0e9e7" stop-opacity=".5"/><stop offset=".45" stop-color="#c3ccd1" stop-opacity=".16"/><stop offset="1" stop-color="#c3ccd1" stop-opacity="0"/></radialGradient>
      <linearGradient id="intro-silver" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f0fffa"/><stop offset=".5" stop-color="#bcded3"/><stop offset="1" stop-color="#49a078" stop-opacity=".6"/></linearGradient>
      <linearGradient id="intro-spirit" x1="0" y1="0" x2="0.7" y2="1"><stop stop-color="#e5faf2" stop-opacity=".42"/><stop offset=".55" stop-color="#97d0bd" stop-opacity=".14"/><stop offset="1" stop-color="#49a078" stop-opacity=".04"/></linearGradient>
      <radialGradient id="intro-mist"><stop stop-color="#bddad1" stop-opacity=".16"/><stop offset="1" stop-color="#c3ccd1" stop-opacity="0"/></radialGradient>
      <radialGradient id="intro-ground"><stop stop-color="#91cbb8" stop-opacity=".18"/><stop offset="1" stop-color="#49a078" stop-opacity="0"/></radialGradient>
      <filter id="intro-halo" x="-25%" y="-20%" width="150%" height="140%"><feGaussianBlur in="SourceGraphic" stdDeviation="2.5"/><feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      <filter id="intro-soft"><feGaussianBlur stdDeviation="3"/></filter>
      <!-- Irregular branches, not repeated triangular icons. -->
      <path id="intro-pine" d="M0 0C-3 20-10 29-19 38L-7 34C-13 47-23 59-33 65L-14 61C-21 79-36 92-48 98L-23 93C-30 108-43 119-59 125L-29 123-7 117-5 156H5L6 116 30 126 57 130C40 115 30 106 23 93L48 100C32 83 25 72 17 58L33 65C18 49 12 37 8 29L19 34C8 19 4 9 0 0Z"/>
    </defs>
    <rect width="1000" height="700" fill="url(#intro-night)"/>
    <g class="intro-sky">
      <circle cx="568" cy="160" r="92" fill="url(#intro-moon)"/>
      <circle cx="568" cy="160" r="25" fill="#c3ccd1" opacity=".19"/>
      <g fill="#cfdfdf" opacity=".3"><circle cx="395" cy="96" r="1"/><circle cx="675" cy="120" r=".8"/><circle cx="463" cy="180" r=".7"/><circle cx="745" cy="64" r="1"/><circle cx="310" cy="144" r=".8"/></g>
      <g class="intro-cloud" fill="url(#intro-mist)"><ellipse cx="565" cy="176" rx="160" ry="27"/><ellipse cx="472" cy="131" rx="150" ry="19"/></g>
    </g>
    <g class="intro-far" fill="#31504d" opacity=".38">
      <use href="#intro-pine" transform="translate(190 190) scale(1.65)"/><use href="#intro-pine" transform="translate(345 230) scale(1.5)"/>
      <use href="#intro-pine" transform="translate(437 265) scale(1.1)"/><use href="#intro-pine" transform="translate(626 210) scale(1.65)"/>
      <use href="#intro-pine" transform="translate(745 175) scale(1.9)"/><use class="intro-extra" href="#intro-pine" transform="translate(870 220) scale(1.7)"/>
    </g>
    <ellipse class="intro-mist intro-mist--back" cx="500" cy="403" rx="490" ry="76" fill="url(#intro-mist)"/>
    <g class="intro-middle" fill="#091f19">
      <use href="#intro-pine" transform="translate(135 60) scale(3.1)"/><use href="#intro-pine" transform="translate(305 155) scale(2.2)" opacity=".85"/>
      <use href="#intro-pine" transform="translate(702 115) scale(2.55)" opacity=".8"/><use href="#intro-pine" transform="translate(885 25) scale(3.4)"/>
    </g>
    <path d="M0 520Q180 476 405 495T1000 492V700H0Z" fill="#04130e"/>
    <ellipse class="intro-ground" cx="496" cy="514" rx="130" ry="19" fill="url(#intro-ground)"/>
    <g class="intro-light" fill="url(#intro-aura)">
      <ellipse cx="508" cy="397" rx="188" ry="182"/>
      <path d="M530 282 348 533Q491 571 650 521Z" opacity=".32"/>
    </g>
    <g class="intro-travel">
      <g class="intro-deer" fill="url(#intro-spirit)" stroke="url(#intro-silver)" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
        <!-- Far limbs sit behind the torso; tapered contours retain joint anatomy. -->
        <path class="deer-leg deer-leg--rear-far" d="M442 402C451 420 456 432 449 445L441 465 451 501 446 505 436 466C432 458 435 448 440 437L430 416Z" opacity=".42"/>
        <path class="deer-leg deer-leg--front-far" d="M504 399C510 417 510 438 519 448L529 459 526 499 520 502 522 461C509 452 501 440 499 428L495 409Z" opacity=".45"/>
        <!-- Spine, haunch and ribcage flow continuously into the breast. -->
        <path class="deer-body" d="M418 400C414 387 421 375 438 371C456 367 476 376 492 373C508 369 515 367 523 378C534 391 529 409 517 418C504 425 487 420 475 416C462 413 451 421 435 416C425 413 421 407 418 400Z"/>
        <path d="M421 385C413 383 407 379 404 374C406 384 411 391 419 393"/>
        <path class="deer-leg deer-leg--rear" d="M434 402C439 410 442 418 434 432L422 450C419 460 425 477 423 499L418 505 412 505 418 496 414 456C412 446 419 435 422 426L419 410Z"/>
        <path class="deer-leg deer-leg--front" d="M513 404C520 412 518 431 516 448L509 497 513 503 504 505 502 500 507 448C504 434 501 422 501 413Z"/>
        <g class="deer-neck">
          <path d="M492 382C509 368 514 346 520 326C525 311 534 304 544 306L558 312C562 317 574 319 578 325Q576 331 566 331L552 328C544 336 548 354 543 373C540 391 533 405 520 415C515 401 506 391 492 382Z"/>
          <path d="M535 309C526 306 521 298 522 291C532 294 537 300 539 307M547 309C549 299 557 292 564 291C562 302 556 308 551 313"/>
          <path d="M543 329Q528 358 530 389M526 342Q520 371 513 380" fill="none" opacity=".4"/>
          <circle cx="559" cy="318" r="1.4" fill="#effff8" stroke="none"/>
          <path d="m570 324 5 1" stroke-width="1"/>
          <g class="deer-antlers" fill="none" stroke-width="1.6">
            <path d="M539 306C535 293 526 279 521 265S518 239 512 226M522 268Q507 265 499 251L491 237M517 251Q526 242 526 230L523 219M505 259Q496 260 487 252M517 239 504 231 500 220"/>
            <path d="M546 305C549 288 557 276 564 263S576 242 573 226M557 276Q551 263 553 249L550 239M567 257Q581 257 590 244L594 232M575 241Q586 235 585 223M554 261 543 252 541 242"/>
          </g>
        </g>
        <!-- Sparse interior light describes ribs and shoulder, not a solid fill. -->
        <path d="M433 383Q465 378 491 390M448 409Q478 403 493 410M511 382Q523 393 518 404" fill="none" opacity=".3"/>
      </g>
      <g class="intro-motes" fill="#d8eee7">
        <circle class="mote mote--a" cx="443" cy="388" r="1.6"/><circle class="mote mote--b" cx="472" cy="376" r="1.1"/>
        <circle class="mote mote--c" cx="520" cy="348" r="1.3"/><circle class="mote mote--a" cx="491" cy="416" r="1"/>
        <circle class="mote mote--b intro-extra" cx="546" cy="295" r="1"/><circle class="mote mote--c intro-extra" cx="430" cy="434" r="1.2"/>
      </g>
    </g>
    <g class="intro-trail" fill="#7bbd9f">
      <circle class="mote mote--a" cx="420" cy="418" r="1.8"/><circle class="mote mote--b" cx="392" cy="432" r="1.2"/>
      <circle class="mote mote--c" cx="452" cy="428" r="1.3"/><circle class="mote mote--a intro-extra" cx="365" cy="441" r="1"/>
    </g>
    <ellipse class="intro-lit-mist" cx="508" cy="479" rx="220" ry="60" fill="url(#intro-aura)"/>
    <g class="intro-mist intro-mist--front" fill="url(#intro-mist)"><ellipse cx="490" cy="508" rx="400" ry="37"/><ellipse class="intro-extra" cx="570" cy="558" rx="360" ry="45"/></g>
    <g class="intro-foreground" fill="none" stroke="#020b08" stroke-linecap="round">
      <path d="M170 730Q227 461 188 50M203 377Q247 328 305 310M198 295Q153 252 98 246M198 225Q239 187 270 122M817 730Q777 397 851 30M805 361Q756 320 719 271M812 274Q875 215 925 205" stroke-width="15"/>
      <path d="m259 327 11-39m-37 62 9-47m523 28-7-43m65-72 41-12" stroke-width="5"/>
    </g>
    <ellipse class="intro-flash" cx="545" cy="407" rx="410" ry="310" fill="url(#intro-aura)"/>
  </svg>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.querySelector('.magic-intro');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    // This runs once while parsing, never in response to selector changes.
    if (!dialog || document.documentElement.dataset.theme !== 'slytherin-magico' || reduced.matches || !dialog.showModal) return;
    const key = 'invitacion-xv-magic-intro-seen';
    try {
      if (sessionStorage.getItem(key)) return;
      sessionStorage.setItem(key, '1');
    } catch { return; } // Prefer an unobstructed invitation if storage is unavailable.
    let timer;
    let finished = false;
    function finish(focusHero = true) {
      if (finished) return;
      finished = true;
      clearTimeout(timer);
      dialog.close();
      reduced.removeEventListener('change', onPreference);
      if (focusHero) {
        const hero = document.getElementById('hero-title');
        if (hero) {
          // Skipping immediately must not leave the original hero entrance pending.
          hero.closest('.hero-content')?.getAnimations({ subtree: true }).forEach((animation) => {
            if (animation.animationName === 'hero-arrive') animation.cancel();
          });
          const previous = hero.getAttribute('tabindex');
          hero.setAttribute('tabindex', '-1');
          hero.focus({ preventScroll: true });
          hero.addEventListener('blur', () => {
            if (previous === null) hero.removeAttribute('tabindex');
            else hero.setAttribute('tabindex', previous);
          }, { once: true });
        }
      }
    }
    function onPreference(event) { if (event.matches) finish(); }
    dialog.querySelector('.intro-skip').addEventListener('click', () => finish());
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); finish(); });
    dialog.addEventListener('wheel', (event) => event.preventDefault(), { passive: false });
    reduced.addEventListener('change', onPreference);
    addEventListener('pagehide', () => finish(false), { once: true });
    dialog.addEventListener('animationend', (event) => {
      if (event.target === dialog) finish();
    });
    try {
      timer = setTimeout(finish, 2950);
      dialog.showModal();
    } catch { finish(false); }
  })();
</script>

<style>
  .magic-intro { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; overflow: hidden; background: #061b13; color: #eef0e8; touch-action: none; }
  .magic-intro::backdrop { background: transparent; }
  .magic-intro:not([open]) { display: none; }
  .intro-scene { display: block; width: 100%; height: 100%; }
  .intro-skip { position: absolute; z-index: 1; top: max(1rem, env(safe-area-inset-top)); right: max(1rem, env(safe-area-inset-right)); min-height: 44px; padding: .6rem 1rem; border: 1px solid #c3ccd1; border-radius: 999px; background: #0b3d2e; color: #eef0e8; font: 0.85rem var(--font-body); cursor: pointer; }
  .intro-skip:hover { background: #14553e; }
  .intro-skip:focus-visible { outline: 3px solid #eef0e8; outline-offset: 4px; }
  .intro-deer { filter: url(#intro-halo); }
  .intro-travel { transform-origin: 500px 510px; }
  .deer-neck { transform-origin: 513px 391px; }
  .deer-antlers { transform-origin: 540px 306px; }
  .deer-leg--rear, .deer-leg--rear-far { transform-origin: 434px 411px; }
  .deer-leg--front, .deer-leg--front-far { transform-origin: 508px 410px; }
  .intro-foreground { filter: url(#intro-soft); }
  .intro-light, .intro-lit-mist, .intro-flash, .mote { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .magic-intro[open] { animation: intro-reveal 2900ms linear both; }
    [open] .intro-sky { animation: sky-drift 2900ms ease-out both; }
    [open] .intro-cloud { animation: cloud-drift 2900ms linear both; }
    [open] .intro-far { animation: far-drift 2900ms ease-out both; }
    [open] .intro-middle { animation: middle-drift 2900ms ease-out both; }
    [open] .intro-foreground { animation: foreground-drift 2900ms ease-out both; }
    [open] .intro-mist--back { animation: mist-drift 2900ms linear both; }
    [open] .intro-mist--front { animation: mist-drift 2900ms linear reverse both; }
    [open] .intro-light { animation: spirit-glow 2350ms 150ms ease-in-out both; }
    [open] .intro-travel { animation: deer-journey 2400ms 150ms ease-in-out both; }
    [open] .intro-deer { animation: spirit-breathe 1800ms 350ms ease-in-out both; }
    [open] .deer-leg--rear, [open] .deer-leg--front-far { animation: leg-step 1800ms 300ms ease-in-out both; }
    [open] .deer-leg--front, [open] .deer-leg--rear-far { animation: leg-step 1800ms 300ms ease-in-out reverse both; }
    [open] .deer-neck { animation: neck-sway 1800ms 300ms ease-in-out both; }
    [open] .deer-antlers { animation: antler-sway 1800ms 350ms ease-in-out both; }
    [open] .intro-ground { animation: ground-follow 2400ms 150ms ease-in-out both; }
    [open] .intro-lit-mist { animation: spirit-glow 1600ms 950ms ease-in-out both; }
    [open] .intro-flash { animation: spirit-glow 800ms 2000ms ease-in-out both; }
    [open] .mote { animation: mote-release 1500ms 500ms ease-out both; }
    [open] .mote--b { animation-delay: 700ms; }
    [open] .mote--c { animation-delay: 950ms; }
  }
  @keyframes intro-reveal { 0%, 76% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes sky-drift { from { transform: translateX(2px); } to { transform: translateX(-2px); } }
  @keyframes cloud-drift { to { transform: translateX(12px); } }
  @keyframes far-drift { from { transform: translateX(4px); opacity: .28; } to { transform: translateX(-5px); opacity: .38; } }
  @keyframes middle-drift { from { transform: translateX(7px); } to { transform: translateX(-9px); } }
  @keyframes foreground-drift { from { transform: translateX(-7px); } to { transform: translateX(10px); } }
  @keyframes spirit-glow { 0%, 100% { opacity: 0; } 45%, 65% { opacity: .8; } }
  @keyframes deer-journey {
    0% { opacity: 0; transform: translate(-30px, -8px) scale(.94); }
    22% { opacity: .85; }
    48% { opacity: 1; transform: translate(-3px, -4px) scale(.98); }
    76% { opacity: .9; transform: translate(19px, 2px) scale(1.025); }
    100% { opacity: 0; transform: translate(33px, 7px) scale(1.045); }
  }
  @keyframes spirit-breathe { 0%, 100% { opacity: .78; } 50% { opacity: 1; } }
  @keyframes leg-step { 0% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } 100% { transform: rotate(-3deg); } }
  @keyframes neck-sway { 0%, 100% { transform: rotate(-1deg); } 50% { transform: rotate(1.3deg); } }
  @keyframes antler-sway { 0%, 100% { transform: rotate(-.6deg); } 50% { transform: rotate(.8deg); } }
  @keyframes ground-follow { 0% { opacity: 0; transform: translate(-30px, -8px); } 35%, 70% { opacity: .8; } 100% { opacity: 0; transform: translate(33px, 7px); } }
  @keyframes mist-drift { from { transform: translateX(-14px); } to { transform: translateX(16px); } }
  @keyframes mote-release { 0% { opacity: 0; transform: translate(0, 3px); } 25% { opacity: .65; } 100% { opacity: 0; transform: translate(-26px, -24px); } }
  @media (max-width: 42rem) {
    .intro-extra, .intro-cloud { display: none; }
    .intro-deer, .intro-foreground { filter: none; }
    .intro-far { opacity: .28; }
    [open] .intro-sky { animation: none; }
  }
  @media (prefers-reduced-motion: reduce) { .magic-intro[open] { display: none; } }
</style>
